<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.farmorai.backend.mapper.AiResultMapper">
    <select id = "getAiResultList" parameterType="Long" resultType ="com.farmorai.backend.dto.AiResultDto">
        SELECT * FROM ai_result WHERE member_id = #{memberId}
    </select>

    <select id = "getAiResult" parameterType="Long" resultType ="com.farmorai.backend.dto.AiResultDto">
        SELECT * FROM ai_result WHERE ai_result_id = #{aiResultId}
    </select>

    <insert id = "insertAiResult" parameterType="com.farmorai.backend.dto.AiResultDto" useGeneratedKeys="true" keyProperty="aiResultId">
        INSERT INTO ai_result (rate_s, rate_a, rate_b, image_url, member_id, subs_id)
        SELECT #{rateS}, #{rateA}, #{rateB}, #{imageUrl}, #{memberId}, subs_id
        FROM subscription
        WHERE member_id = #{memberId} AND status = 'ACTIVE'
        LIMIT 1;
    </insert>

    <delete id = "deleteAiResult" parameterType="Long">
        DELETE FROM ai_result WHERE ai_result_id = #{aiResultId}
    </delete>
</mapper>